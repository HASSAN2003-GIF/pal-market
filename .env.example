# PAL Market environment template. Copy to .env and fill in.
# Never commit real secrets. Values marked [production] matter for live deployments.

APP_NAME="PAL Market"
APP_ENV=local                     # [production] production
APP_KEY=                          # generate with: php artisan key:generate
APP_DEBUG=true                    # [production] false (never true in production)
APP_URL=http://localhost          # [production] https://your-domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single                  # [production] daily, or stderr on container platforms
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                   # [production] info or warning

# Database. These defaults match Laravel Sail (docker compose).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password              # [production] a strong, unique password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false       # [production] true (HTTPS only)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# API tokens expire after this many minutes (default 7 days). 0 = never (not recommended).
SANCTUM_TOKEN_EXPIRATION=10080

# Extra origins allowed to call the API cross-origin, comma separated.
# The bundled SPA is same-origin and needs nothing here.
CORS_ALLOWED_ORIGINS=

# Load balancer / reverse proxy IPs, comma separated (or * behind a trusted proxy).
# Must be a real environment variable: it is read before configuration is cached.
TRUSTED_PROXIES=

# Mail is required for password reset emails.
MAIL_MAILER=log                   # [production] smtp, ses, postmark or resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console.
# Authorised redirect URI must equal GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
